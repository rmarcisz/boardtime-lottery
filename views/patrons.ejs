<%- include("partials/head", { title: "Patroni" }) %>
<%- include("partials/nav") %>
<main class="page">
  <h1>Patroni</h1>

  <% if (error) { %><p class="error"><%= error.replace(/\+/g, " ") %></p><% } %>
  <% if (typeof cleared !== "undefined" && cleared) { %>
    <p class="notice">Baza danych została wyczyszczona.</p>
  <% } %>

  <form method="POST" action="/patrons" class="add-patron-form">
    <input type="text" name="name" placeholder="Imię i nazwisko / nick" required autofocus>
    <button type="submit" class="primary">Dodaj patrona</button>
  </form>

  <table class="tickets-table">
    <thead>
      <tr><th>Patron</th><th>Kupony (łącznie)</th><th>Status</th><th></th></tr>
    </thead>
    <tbody>
      <% patrons.forEach(function(p) { %>
        <tr class="<%= p.active ? '' : 'inactive' %>">
          <td><%= p.name %></td>
          <td class="tickets-count"><%= p.tickets %></td>
          <td><%= p.active ? "aktywny" : "nieaktywny" %></td>
          <td class="row-actions">
            <form method="POST" action="/patrons/<%= p.id %>/toggle" class="inline">
              <button type="submit" class="link-btn">
                <%= p.active ? "dezaktywuj" : "aktywuj" %>
              </button>
            </form>
            <form method="POST" action="/patrons/<%= p.id %>/delete" class="inline"
                  onsubmit="return confirm('Usunąć <%= p.name.replace(/'/g, "\\'") %> na stałe? To usunie też całą jego historię kuponów.');">
              <button type="submit" class="link-btn danger">usuń</button>
            </form>
          </td>
        </tr>
      <% }) %>
      <% if (!patrons.length) { %>
        <tr><td colspan="4" class="muted">Brak patronów. Dodaj pierwszego powyżej.</td></tr>
      <% } %>
    </tbody>
  </table>

  <p class="muted">
    Dezaktywowany patron przestaje dostawać comiesięczne kupony, ale zachowuje historię.
    Usunięcie jest trwałe i kasuje całą jego historię.
  </p>

  <div class="card danger-zone">
    <h2>Strefa niebezpieczna</h2>
    <p class="muted">
      Usuwa <strong>wszystko</strong>: wszystkich patronów, całą historię kuponów
      i wszystkie miesiące. Nie da się tego cofnąć.
    </p>
    <form method="POST" action="/admin/clear-database" id="clear-db-form"
          onsubmit="return confirm('Na pewno wyczyścić całą bazę danych? Wszyscy patroni i cała historia kuponów zostaną usunięte bezpowrotnie.');">
      <label for="clear-confirm" class="muted">
        Wpisz <strong>WYCZYŚĆ</strong>, żeby odblokować przycisk:
      </label>
      <div class="danger-confirm-row">
        <input type="text" id="clear-confirm" autocomplete="off" placeholder="WYCZYŚĆ">
        <button type="submit" class="danger-btn" id="clear-db-btn" disabled>Wyczyść bazę danych</button>
      </div>
    </form>
  </div>

  <script>
    (function () {
      var input = document.getElementById("clear-confirm");
      var btn = document.getElementById("clear-db-btn");
      input.addEventListener("input", function () {
        btn.disabled = input.value.trim() !== "WYCZYŚĆ";
      });
    })();
  </script>
</main>
<%- include("partials/foot") %>
