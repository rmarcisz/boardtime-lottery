# Postgres connection string (Render provides this automatically when you
# link a Postgres instance to the web service as DATABASE_URL).
DATABASE_URL=postgres://user:password@localhost:5432/boardtimes_lottery

# Shared password to access the whole site (patron list, month advance, draws).
ADMIN_PASSWORD=change-me

# Random long string used to sign session cookies.
SESSION_SECRET=change-me-too

# Port the server listens on (Render sets this automatically in production).
PORT=3000
