# Turso (libSQL) database connection.
# Get these with the Turso CLI: `turso db show <name> --url` and
# `turso db tokens create <name>`.
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=change-me

# Shared password to access the whole site (patron list, month advance, draws).
ADMIN_PASSWORD=change-me

# Random long string used to sign session cookies.
SESSION_SECRET=change-me-too

# Port the server listens on (Render sets this automatically in production).
PORT=3000
